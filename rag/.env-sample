# =======================================
# CONFIGURACIÓN DE RAG (Retrieval Augmented Generation)
# =======================================
# 
# ⚠️  IMPORTANTE: Copia este archivo como .env y configura tus variables
# cp .env-sample .env
#
# Este archivo contiene las variables de entorno necesarias para el sistema RAG
# que utiliza GitHub Models para embeddings y generación, y Qdrant como base de datos vectorial.

# 🔗 GitHub Models Configuration
# URL base para la API de GitHub Models
GITHUB_MODELS_URL=https://models.inference.ai.azure.com

# Token de autenticación para GitHub Models
GITHUB_TOKEN=tu_github_token_aqui

# 🤖 Modelos para diferentes tareas
# Modelo para generar embeddings (ej: text-embedding-3-small, text-embedding-3-large)
GITHUB_MODELS_MODEL_FOR_EMBEDDINGS=text-embedding-3-large

# Modelo para generar respuestas (ej: gpt-4o-mini, gpt-4o)
GITHUB_MODELS_MODEL_FOR_GENERATION=gpt-4o

# 🗄️ Qdrant Configuration (Base de datos vectorial)
# URL de tu instancia de Qdrant (local o en la nube)
QDRANT_URL=http://localhost:6333

# Nombre de la colección en Qdrant donde se almacenarán los embeddings
QDRANT_COLLECTION_NAME=youtube_guides

# 📝 NOTAS:
# - Para instalar Qdrant localmente: docker run -p 6333:6333 qdrant/qdrant
# - También puedes usar Qdrant Cloud: https://cloud.qdrant.io/
# - Los embeddings se generan con GitHub Models y se almacenan en Qdrant
# - El sistema puede procesar documentos markdown y responder preguntas basándose en el contenido
