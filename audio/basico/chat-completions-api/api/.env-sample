# =======================================
# CONFIGURACIÓN DE CHAT CON AUDIO (BÁSICO)
# =======================================
# 
# ⚠️  IMPORTANTE: Copia este archivo como .env y configura tus variables
# cp .env-sample .env
#
# Este archivo contiene las variables de entorno necesarias para el chat
# con capacidades de audio básicas usando modelos de OpenAI.

# 🔗 OpenAI/Azure OpenAI Configuration
# URL del endpoint para la API
ENDPOINT_URL=https://api.openai.com/v1

# Clave de API para autenticación
API_KEY=tu_openai_api_key_aqui

# 🤖 Modelo con capacidades de audio (debe soportar modalidades de audio)
MODEL_FOR_AUDIO=gpt-4o-audio-preview

# 📝 NOTA: Para usar Azure OpenAI, cambia ENDPOINT_URL por tu endpoint de Azure
# Ejemplo: ENDPOINT_URL=https://tu-recurso.openai.azure.com/openai/deployments/gpt-4o-audio/

# IMPORTANTE:
# - Nunca subas el archivo .env real al repositorio
# - Mantén tus API keys seguras y privadas
# - El modelo gpt-4o-audio-preview puede requerir acceso especial
