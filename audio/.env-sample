# =======================================
# CONFIGURACIÓN DE DEMOS DE AUDIO
# =======================================
# 
# ⚠️  IMPORTANTE: Copia este archivo como .env y configura tus variables
# cp .env-sample .env
#
# Este archivo contiene las variables de entorno necesarias para todos
# los demos de audio (básicos y avanzados).

# 🔗 OpenAI Configuration (Principal para audio)
# Clave de API de OpenAI - requerida para todos los demos de audio
OPENAI_API_KEY=tu_openai_api_key_aqui

# URL del endpoint (por defecto OpenAI, cambiar para Azure OpenAI)
ENDPOINT_URL=https://api.openai.com/v1

# Clave de API genérica (para demos que usan API_KEY en lugar de OPENAI_API_KEY)
API_KEY=tu_openai_api_key_aqui

# 🤖 Modelos específicos para audio
# Modelo con capacidades de audio multimodal
MODEL_FOR_AUDIO=gpt-4o-audio-preview

# 🌐 Configuración del servidor (para demos con servidor)
# Host donde correrán los servidores (por defecto: 0.0.0.0)
HOST=0.0.0.0

# Puerto para demos básicos (por defecto: 5000)
PORT=5000

# Activar modo debug (por defecto: True para desarrollo)
DEBUG=True

# 🔗 Azure OpenAI Configuration (Alternativa)
# Descomenta y configura para usar Azure OpenAI
# ENDPOINT_URL=https://tu-recurso.openai.azure.com/openai/deployments/
# OPENAI_API_KEY=tu_azure_api_key_aqui
# API_KEY=tu_azure_api_key_aqui

# 📝 DEMOS INCLUIDOS:
# - basico/speech-to-text: Transcripción de audio con Whisper
# - basico/transcription: Transcripción avanzada con chunks
# - basico/chat-completions-api: Chat con audio usando Chat Completions
# - avanzado/chat-completions: Chat multimodal con audio
# - avanzado/realtime-api: Conversaciones en tiempo real

# 🔐 SEGURIDAD:
# - Para Realtime API, el servidor genera ephemeral keys
# - NUNCA expongas tu OPENAI_API_KEY en el frontend
# - Usa el servidor proxy para manejar la autenticación de forma segura
