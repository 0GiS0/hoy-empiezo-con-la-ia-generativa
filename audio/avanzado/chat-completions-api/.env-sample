# OpenAI Configuration for Audio API
ENDPOINT_URL="https://api.openai.com/v1"
API_KEY="YOUR_OPENAI_API_KEY_HERE"
MODEL_FOR_AUDIO="gpt-4o-audio-preview"

# Para usar este servicio necesitas:
# 1. Copiar este archivo como .env: cp .env-sample .env
# 2. Reemplazar YOUR_OPENAI_API_KEY_HERE con tu API key real de OpenAI
# 3. Asegurarte de tener acceso al modelo gpt-4o-audio-preview

# IMPORTANTE:
# - Nunca subas el archivo .env real al repositorio
# - Mantén tus API keys seguras y privadas
# - El modelo gpt-4o-audio-preview puede requerir acceso especial
