# =======================================
# CONFIGURACIÓN DE CHAT CON AUDIO AVANZADO
# =======================================
# 
# ⚠️  IMPORTANTE: Copia este archivo como .env y configura tus variables
# cp .env-sample .env
#
# Este archivo contiene las variables de entorno necesarias para el chat
# avanzado con audio usando la API de Chat Completions con modalidades.

# 🔗 OpenAI Configuration
# Clave de API de OpenAI (requerida)
OPENAI_API_KEY=tu_openai_api_key_aqui

# 🤖 Modelo con capacidades de audio
# Modelos compatibles: gpt-4o-audio-preview, etc.
MODEL_FOR_AUDIO=gpt-4o-audio-preview

# 🌐 Configuración del servidor (opcional)
# Host donde correrá el servidor (por defecto: 0.0.0.0)
HOST=0.0.0.0

# Puerto donde correrá el servidor (por defecto: 5000)
PORT=5000

# Activar modo debug (por defecto: True)
DEBUG=True

# 📝 NOTA: Este demo requiere una API key de OpenAI válida y acceso 
# a modelos con capacidades de audio multimodal.
