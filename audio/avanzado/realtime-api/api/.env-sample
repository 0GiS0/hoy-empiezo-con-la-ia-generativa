# =======================================
# CONFIGURACIÓN DE REALTIME API (AUDIO AVANZADO)
# =======================================
# 
# ⚠️  IMPORTANTE: Copia este archivo como .env y configura tus variables
# cp .env-sample .env
#
# Este archivo contiene las variables de entorno necesarias para el servidor
# de ephemeral keys que permite usar la Realtime API de OpenAI de forma segura.

# 🔗 OpenAI Configuration (REQUERIDO)
# Tu API key de OpenAI - NUNCA expongas esta clave en el frontend
OPENAI_API_KEY=sk-tu-openai-api-key-aqui

# 🌐 Configuración del servidor (opcional)
# Host donde correrá el servidor (por defecto: 0.0.0.0)
HOST=0.0.0.0

# Puerto donde correrá el servidor (por defecto: 8000)
PORT=8000

# Activar modo debug (por defecto: false para producción)
DEBUG=false

# 🔐 SEGURIDAD:
# - Este servidor genera ephemeral keys que expiran rápidamente
# - NUNCA uses tu OPENAI_API_KEY directamente en el frontend
# - Las ephemeral keys tienen permisos limitados y tiempo de vida corto
# - El servidor actúa como proxy seguro entre tu frontend y OpenAI

# 📝 NOTAS:
# - La Realtime API permite conversaciones de voz en tiempo real
# - Requiere WebSockets y manejo de audio en el navegador
# - Es ideal para asistentes de voz y aplicaciones conversacionales
