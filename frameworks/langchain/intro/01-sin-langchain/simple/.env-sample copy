# =======================================
# CONFIGURACIÓN DEMO: INTRO SIN LANGCHAIN
# =======================================
#
# ⚠️ IMPORTANTE: Copia este archivo como .env y configura tus variables
# cp .env-sample .env
#
# Este ejemplo usa el SDK de OpenAI apuntando a GitHub Models
# (endpoint compatible con OpenAI). Más info en el README del repo.

# 🔗 Configuración de endpoint/credenciales (GitHub Models)
# URL del endpoint compatible con OpenAI
GITHUB_MODELS_URL="https://models.github.ai/inference"

# Token de GitHub con acceso a "Models" (o GITHUB_TOKEN en Codespaces)
GITHUB_TOKEN=tu_personal_access_token_con_acceso_a_models

# GitHub Model ID
GITHUB_MODEL_ID=openai/gpt-4.1

# 📝 Parámetros de la demo
# Título de YouTube a mejorar en app.py
YOUTUBE_TITLE="Introducción a Langchain"

# Temperatura por defecto
TEMPERATURE=0.7