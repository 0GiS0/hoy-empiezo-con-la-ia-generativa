# Demo con LangChain — variables de entorno
# Copia este archivo a ".env" y rellena los valores.

# URL base de GitHub Models (OpenAI SDK compatible)
GITHUB_MODELS_URL="https://models.github.ai/inference"

# Token personal de GitHub con acceso a GitHub Models
GITHUB_TOKEN=ghp_xxx_tu_token

# ID del modelo a usar (ejemplos: openai/gpt-4o-mini, openai/gpt-4.1-mini)
GITHUB_MODEL_ID="openai/gpt-4.1"

# Título de YouTube de ejemplo para la demo
YOUTUBE_TITLE="Introducción a LangChain"
