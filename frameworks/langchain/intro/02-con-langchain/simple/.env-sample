# Demo con LangChain — variables de entorno
# Copia este archivo a ".env" y rellena los valores.

## URL base del endpoint del modelo (ej: https://api.openai.com/v1, https://models.inference.ai.azure.com, http://localhost:11434/v1)
# LLM_BASE_URL="https://models.github.ai/inference"

# ## Clave / token de acceso al proveedor (OPENAI_API_KEY, GITHUB_TOKEN, etc.)
# LLM_API_KEY=tu_api_key_o_token

# ## Proveedor / SDK interno que usará LangChain (openai, github, ollama, etc.)
# MODEL_PROVIDER="openai"

# ## ID del modelo (ej: gpt-4o-mini, openai/gpt-4.1-mini, ollama/llama3)
# LLM_MODEL_ID=openai/gpt-4.1

# Título de YouTube de ejemplo para la demo
YOUTUBE_TITLE="Introducción a LangChain"

# Temperatura por defecto
TEMPERATURE=0.7

# ------------------------------------------------------------
# Ejemplo de configuración para Ollama (uso local)
# Descomenta estas líneas para usar un modelo servido por Ollama
# Necesitas tener Ollama instalado y el modelo descargado (e.g. `ollama run llama3.1`)
# ------------------------------------------------------------
# LLM_BASE_URL="http://host.docker.internal:11434"
# MODEL_PROVIDER="ollama"
# LLM_MODEL_ID="gemma3:1b"   # Reemplaza por el nombre que muestra `ollama list`
# LLM_API_KEY="ollama"       # Valor dummy, no se valida

