# =======================================
# CONFIGURACIÓN DE GENERACIÓN DE TEXTO (SCRIPTS)
# =======================================
# 
# ⚠️  IMPORTANTE: Copia este archivo como .env y configura tus variables
# cp .env-sample .env
#
# Este archivo contiene las variables de entorno necesarias para ejecutar
# los scripts de demostración de generación de texto.

# 🔗 GitHub Models Configuration
# URL base para la API de GitHub Models
GITHUB_MODELS_URL=https://models.inference.ai.azure.com

# Token de autenticación para GitHub Models
GITHUB_TOKEN=tu_github_token_aqui

# 🦙 Ollama Configuration (para uso local)
# URL base para el servidor de Ollama (ajustar si corre en otro puerto o host)
OLLAMA_URL=http://localhost:11434

# 📝 NOTA: Estos scripts demuestran generación de texto con y sin streaming
# usando tanto GitHub Models como Ollama para comparar diferentes enfoques.
