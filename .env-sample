# =======================================
# CONFIGURACIÓN PRINCIPAL - HOY EMPIEZO CON IA GENERATIVA
# =======================================
# 
# ⚠️  IMPORTANTE: Copia este archivo como .env y configura tus variables
# cp .env-sample .env
#
# Este archivo contiene las variables de entorno principales que pueden
# ser usadas por múltiples demos del repositorio.

# 🔗 GitHub Models Configuration (Principal)
# URL base para la API de GitHub Models
GITHUB_MODELS_URL=https://models.inference.ai.azure.com
GITHUB_MODELS_API_URL=https://models.inference.ai.azure.com

# Token de autenticación para GitHub Models
GITHUB_TOKEN=tu_github_token_aqui
GITHUB_MODELS_API_KEY=tu_github_token_aqui

# Modelos de GitHub Models comunes
GITHUB_MODELS_MODEL=gpt-4o-mini
GITHUB_MODELS_MODEL_FOR_EMBEDDINGS=text-embedding-3-small
GITHUB_MODELS_MODEL_FOR_GENERATION=gpt-4o-mini

# 🔗 OpenAI Configuration
# Clave de API de OpenAI
OPENAI_API_KEY=tu_openai_api_key_aqui

# URL del endpoint de OpenAI
ENDPOINT_URL=https://api.openai.com/v1

# Clave de API genérica (para compatibilidad)
API_KEY=tu_openai_api_key_aqui

# Modelos de OpenAI comunes
MODEL_FOR_AUDIO=gpt-4o-audio-preview
MODEL_FOR_VISION=gpt-4o
IMAGE_GENERATION_MODEL=gpt-4o

# 🦙 Ollama Configuration (para uso local)
# URL base para el servidor de Ollama
OLLAMA_API_URL=http://localhost:11434
OLLAMA_URL=http://localhost:11434

# Modelo de Ollama por defecto
OLLAMA_MODEL=llama3

# 🗄️ Qdrant Configuration (para RAG)
# URL de tu instancia de Qdrant
QDRANT_URL=http://localhost:6333

# Nombre de la colección por defecto
QDRANT_COLLECTION_NAME=mi_coleccion

# 🌐 Configuración de servidores
# Host por defecto para servidores Flask
HOST=0.0.0.0

# Puerto por defecto
PORT=5000

# Modo debug
DEBUG=True

# =======================================
# INSTRUCCIONES POR DEMO
# =======================================
#
# 📁 CHAT (/chat/api)
# Necesita: GITHUB_MODELS_*, OLLAMA_*
#
# 📁 TEXT-GENERATION (/text-generation/api)
# Necesita: GITHUB_MODELS_*, OLLAMA_*
#
# 📁 PROMPT-ENGINEERING (/prompt-engineering/api)
# Necesita: GITHUB_MODELS_*, OLLAMA_*
#
# 📁 IMAGES (/images/*)
# Necesita: ENDPOINT_URL, API_KEY, *_MODEL variables
#
# 📁 AUDIO (/audio/*)
# Necesita: OPENAI_API_KEY, MODEL_FOR_AUDIO, server configs
#
# 📁 RAG (/rag)
# Necesita: GITHUB_MODELS_*, QDRANT_*
#
# 📝 NOTA: Cada demo también tiene su propio .env-sample específico
# con instrucciones detalladas. Usa este archivo como base común.
