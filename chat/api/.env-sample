# =======================================
# CONFIGURACIÓN DEL CHAT (ASISTENTE DE YOUTUBE)
# =======================================
# 
# ⚠️  IMPORTANTE: Copia este archivo como .env y configura tus variables
# cp .env-sample .env
#
# Este archivo contiene las variables de entorno necesarias para el chat
# que actúa como asistente de YouTube, con soporte para GitHub Models y Ollama.

# 🔗 GitHub Models Configuration
# URL base para la API de GitHub Models
GITHUB_MODELS_API_URL=https://models.inference.ai.azure.com

# Modelo de GitHub Models a utilizar (ej: gpt-4o-mini, gpt-4o)
GITHUB_MODELS_MODEL=gpt-4o-mini

# Token de autenticación para GitHub Models (puede ser GITHUB_TOKEN o GITHUB_MODELS_API_KEY)
GITHUB_MODELS_API_KEY=tu_github_token_aqui

# 🦙 Ollama Configuration (para uso local)
# URL base para el servidor de Ollama
OLLAMA_API_URL=http://localhost:11434

# Modelo de Ollama a utilizar (ej: llama3, mistral, codellama)
OLLAMA_MODEL=llama3
