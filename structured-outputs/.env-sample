# =======================================
# CONFIGURACIÓN DEMO: STRUCTURED OUTPUTS
# =======================================
# 
# ⚠️  IMPORTANTE: Copia este archivo como .env y configura tus variables
# cp .env-sample .env
#
# Este archivo contiene las variables de entorno necesarias para el demo
# "structured-outputs" (scripts de generación y evaluación de títulos).



# 🔗 Configuración del endpoint y API Key
# Usa SIEMPRE estas dos variables para el SDK de OpenAI en este repo.
# Por defecto apunta a OpenAI.
ENDPOINT_URL="https://models.github.ai/inference"
API_KEY=tu_api_key_aqui

# Alternativa (compatible con otros demos):
# OPENAI_API_KEY=tu_api_key_aqui

# 🤖 Modelo por defecto para structured outputs (Responses API)
# Ajusta si quieres usar otro modelo compatible.
STRUCTURED_OUTPUTS_MODEL="openai/gpt-4.1"

# 🚫 Ollama: actualmente no recomendado para este demo
# (no soporta structured outputs del Responses API a día de hoy)

# 🔐 Seguridad
# - NUNCA subas tu .env al repositorio.
# - Usa tokens de entorno locales/seguro.
