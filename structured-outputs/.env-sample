# =======================================
# CONFIGURACIÓN DEMO: STRUCTURED OUTPUTS
# =======================================
#
# ⚠️  IMPORTANTE: Copia este archivo como .env y configura tus variables
# cp .env-sample .env
#
# Este archivo contiene las variables de entorno necesarias para el demo
# "structured-outputs" (scripts de generación y evaluación de títulos).

# 👩🏼‍💻 Inputs para la demo
YOUTUBE_TITLE="Pedir Outputs estructurados a los modelos de IA Generativa"

# 🔗 Configuración del endpoint y API Key
# Usa SIEMPRE estas dos variables para el SDK en este repo.
# Por defecto, este ejemplo apunta a GitHub Models (ajústalo si usas otro backend).
ENDPOINT_URL="https://models.github.ai/inference"
API_KEY=tu_api_key_aqui

# Alternativas (compatibles con otros demos)
# - OpenAI directo
#   ENDPOINT_URL=https://api.openai.com/v1
#   API_KEY=tu_openai_api_key
#   # o bien
#   # OPENAI_API_KEY=tu_openai_api_key

# - GitHub Models (Azure endpoint)
#   ENDPOINT_URL=https://models.inference.ai.azure.com
#   API_KEY=$GITHUB_TOKEN
#   MODEL_NAME=gpt-4o-mini

# 🤖 Modelo a utilizar
# Debe ser compatible con Chat Completions y parse (structured outputs).
MODEL_NAME="openai/gpt-4.1"

# 🚫 Ollama: no recomendado para este demo
# (parse puede no estar disponible en todos los backends)

# 🔐 Seguridad
# - NUNCA subas tu .env al repositorio.
# - Usa tokens de entorno locales/seguros.
