# =======================================
# CONFIGURACIÓN DE GENERACIÓN Y VISIÓN DE IMÁGENES
# =======================================
# 
# ⚠️  IMPORTANTE: Copia este archivo como .env y configura tus variables
# cp .env-sample .env
#
# Este archivo contiene las variables de entorno necesarias para todos
# los demos de imágenes (generación y visión).

# 🔗 OpenAI Configuration (Recomendado para imágenes)
# URL del endpoint para la API de OpenAI
ENDPOINT_URL=https://api.openai.com/v1

# Clave de API de OpenAI
API_KEY=tu_openai_api_key_aqui

# Modelo para análisis de imágenes (visión)
MODEL_FOR_VISION=gpt-4o

# Modelo para generación de imágenes via Responses API
IMAGE_GENERATION_MODEL=gpt-4o

# 🔗 GitHub Models Configuration (Alternativa)
# Descomenta estas líneas para usar GitHub Models en lugar de OpenAI
# ENDPOINT_URL=https://models.inference.ai.azure.com
# API_KEY=tu_github_token_aqui
# MODEL_FOR_VISION=gpt-4o
# IMAGE_GENERATION_MODEL=gpt-4o

# 🔗 Azure OpenAI Configuration (Alternativa)
# Descomenta y configura para usar Azure OpenAI
# ENDPOINT_URL=https://tu-recurso.openai.azure.com/openai/deployments/
# API_KEY=tu_azure_api_key_aqui
# MODEL_FOR_VISION=gpt-4o
# IMAGE_GENERATION_MODEL=gpt-4o

# 🦙 Ollama Configuration (Solo para visión, no generación de imágenes)
# Descomenta para usar Ollama local para análisis de imágenes
# ENDPOINT_URL=http://localhost:11434/v1
# API_KEY=ollama
# MODEL_FOR_VISION=llava

# 📝 NOTAS:
# - OpenAI es recomendado para generación de imágenes (DALL-E)
# - Para visión, puedes usar OpenAI, GitHub Models, Azure OpenAI o Ollama (llava)
# - Los demos incluyen generación y análisis de imágenes
# - Algunos demos requieren modelos específicos con capacidades multimodales
