# =======================================
# CONFIGURACIÓN DE GENERACIÓN DE IMÁGENES (Responses API)
# =======================================
# 
# ⚠️  IMPORTANTE: Copia este archivo como .env y configura tus variables
# cp .env-sample .env
#
# Este archivo contiene las variables de entorno necesarias para generar
# imágenes usando la API de Responses de OpenAI (para conversaciones con imágenes).

# 🔗 OpenAI/Azure OpenAI Configuration
# URL del endpoint para la API
ENDPOINT_URL=https://api.openai.com/v1

# Clave de API para autenticación
API_KEY=tu_openai_api_key_aqui

# 🤖 Modelo específico para generación de imágenes via Responses API
# Modelos compatibles: gpt-4o, gpt-4o-mini, etc. (que soporten herramientas de generación de imágenes)
IMAGE_GENERATION_MODEL=gpt-4o

# 📝 NOTA: Para usar Azure OpenAI, cambia ENDPOINT_URL por tu endpoint de Azure
# Ejemplo: ENDPOINT_URL=https://tu-recurso.openai.azure.com/openai/deployments/
